[*.cs]
# A test that blocks on a task, or drops one, deadlocks or misses its failure only sometimes.
dotnet_diagnostic.xUnit1030.severity = error
dotnet_diagnostic.xUnit1031.severity = error
dotnet_diagnostic.xUnit1048.severity = error
dotnet_diagnostic.xUnit1051.severity = error
dotnet_diagnostic.VSTHRD002.severity = error
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD101.severity = error
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.CS4014.severity = error
# A test has no reason to leave xUnit's synchronization context.
dotnet_diagnostic.CA2007.severity = none
# Style, and the threading rules for a program with a main thread to protect. Neither makes a test flaky.
dotnet_diagnostic.VSTHRD003.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.VSTHRD200.severity = none
