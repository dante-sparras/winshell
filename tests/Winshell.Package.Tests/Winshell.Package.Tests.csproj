<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winshell.Services\Winshell.Services.csproj" />
    <!-- The CLI that lists and kills the shell, built but not copied: winshell.exe sits beside the winshell.dll its
         build reports. The shell itself is the program a template builds. -->
    <ProjectReference Include="..\..\src\Winshell\Winshell.csproj" ReferenceOutputAssembly="false" OutputItemType="WinshellCliAssembly" />
  </ItemGroup>
  <Target Name="NameWinshellCli" AfterTargets="ResolveProjectReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="WinshellCli" Value="@(WinshellCliAssembly->'%(RootDir)%(Directory)%(Filename).exe')" />
    </ItemGroup>
  </Target>
</Project>
