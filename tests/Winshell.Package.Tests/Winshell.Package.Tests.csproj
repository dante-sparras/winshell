<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winshell.Services\Winshell.Services.csproj" />
    <!-- The CLI that lists and kills the shell. The shell itself is the program a template builds. -->
    <ProjectReference Include="..\..\src\Winshell\Winshell.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="WinshellCli" Value="$(MSBuildThisFileDirectory)..\..\src\Winshell\bin\$(Configuration)\$(TargetFramework)\winshell.exe" />
  </ItemGroup>
</Project>
