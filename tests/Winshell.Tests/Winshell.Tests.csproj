<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <!-- The referenced winshell.exe carries the Windows App SDK, so this program inherits it. The check wants an
         architecture, and the exe stays beside the tests. The startup types stay in winshell.exe: compiling them again
         here clashes with the ones that assembly already exposes. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests run winshell.exe itself, as separate processes. -->
    <ProjectReference Include="..\..\src\Winshell\Winshell.csproj" />
  </ItemGroup>
</Project>
