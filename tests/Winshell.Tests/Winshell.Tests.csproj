<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests run winshell.exe itself, as separate processes. -->
    <ProjectReference Include="..\..\src\Winshell\Winshell.csproj" />
    <!-- And winshell-next.exe, which is self-contained and stays in a folder of its own. -->
    <ProjectReference Include="..\..\src\Winshell.Next\Winshell.Next.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <AssemblyMetadata Include="WinshellNext" Value="$(MSBuildThisFileDirectory)..\..\src\Winshell.Next\bin\$(Configuration)\$(TargetFramework)\$(NETCoreSdkRuntimeIdentifier)\winshell-next.exe" />
  </ItemGroup>
</Project>
