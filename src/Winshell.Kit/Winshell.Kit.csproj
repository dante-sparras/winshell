<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Kit: the controls and tokens every plugin draws its bar item and panel with (ADR 0045).
    Code only, with no XAML of its own, so a plugin outside the app needs no resource merging.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Winshell.Kit</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- No resources of its own, so no PRI file to generate. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <Platforms>x86;x64;ARM64;AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The desktop installs the unthemed tokens before the first brush is read. -->
    <InternalsVisibleTo Include="Winoma.Desktop" />
    <ProjectReference Include="..\Winshell.Core\Winshell.Core.csproj" />
    <Using Include="Winshell.Core" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
  </ItemGroup>
</Project>
