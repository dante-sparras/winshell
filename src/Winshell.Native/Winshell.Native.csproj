<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <InternalsVisibleTo Include="Winshell.Core" />
    <InternalsVisibleTo Include="Winshell.Services" />
    <InternalsVisibleTo Include="Winshell.Shell" />
    <!-- Every test project, found by its folder, so a new one needs no line here. Each compiles tests/TestSupport,
         whose parent process watch asks ProcessImage for this process's parent. -->
    <WinshellTestProject Include="$(MSBuildThisFileDirectory)..\..\tests\*\*.csproj" />
    <InternalsVisibleTo Include="@(WinshellTestProject->'%(Filename)')" />
  </ItemGroup>
</Project>
