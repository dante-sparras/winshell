<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Winshell</PackageId>
    <Description>The library a Winshell configuration references: native operations, services and WinUI windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/enpaze/winshell</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Dante Sparrås</Copyright>
    <!-- The project's own assembly is a marker. The package carries the libraries referenced below. -->
  </PropertyGroup>

  <!-- What a configuration's project restores. WinUI is these two packages, self-contained in that project. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <!-- Private so the package does not depend on separate Winshell module packages. The assemblies are included below. -->
  <ItemGroup>
    <ProjectReference Include="..\Winshell.Native\Winshell.Native.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Winshell.Core\Winshell.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Winshell.Shell\Winshell.Shell.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Winshell.Services\Winshell.Services.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- IncludeBuildOutput stays false, so the marker assembly is not packed. NuGet only
       copies BuildOutputInPackage when IncludeBuildOutput is true, so the libraries go in as files.
       ReferenceSourceTarget is ProjectReference on each referenced project's output, which keeps
       the library names in the ProjectReference list. A package asset such as WebView2 is not. -->
  <Target Name="IncludeWinshellAssemblies" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- WithMetadataValue skips an asset that does not define ReferenceSourceTarget. A bare
           %(ReferenceSourceTarget) condition fails the pack on that asset (MSB4096). -->
      <None Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"
            Condition="'%(Extension)' == '.dll'">
        <Pack>true</Pack>
        <PackagePath>lib/$(TargetFramework)/%(Filename)%(Extension)</PackagePath>
      </None>
    </ItemGroup>
  </Target>
</Project>
