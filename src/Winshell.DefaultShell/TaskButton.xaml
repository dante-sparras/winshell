<Button
    x:Class="Winshell.DefaultShell.TaskButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="40"
    Height="40"
    MinWidth="40"
    MinHeight="40"
    Padding="0"
    BorderThickness="0"
    Background="Transparent"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    CornerRadius="{ThemeResource ControlCornerRadius}">
    <Grid Width="40" Height="40">
        <Border x:Name="FillActive" CornerRadius="{ThemeResource ControlCornerRadius}" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Border x:Name="FillAttention" CornerRadius="{ThemeResource ControlCornerRadius}" Visibility="Collapsed" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <Image x:Name="Icon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
        <Border x:Name="MarkRest" Width="6" Height="3" Margin="0,0,0,2" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" Background="{ThemeResource TextFillColorTertiaryBrush}" />
        <Border x:Name="MarkActive" Width="16" Height="3" Margin="0,0,0,2" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" Background="{ThemeResource AccentFillColorDefaultBrush}" />
        <Border x:Name="MarkAttention" Width="6" Height="3" Margin="0,0,0,2" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" Background="{ThemeResource SystemFillColorCriticalBrush}" />
        <Border x:Name="Stroke" CornerRadius="{ThemeResource ControlCornerRadius}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed" />
    </Grid>
</Button>
