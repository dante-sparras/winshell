<UserControl
    x:Class="Winshell.DefaultShell.StartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    xmlns:taskbar="using:Winshell.DefaultShell.Taskbar"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    IsTabStop="False"
    PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="StartRow" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="SearchHost">
            <TextBox
                x:Name="SearchBox"
                Padding="36,5,12,6"
                VerticalContentAlignment="Center"
                PlaceholderText="Search apps"
                AutomationProperties.Name="Search apps"
                TextChanged="OnQueryChanged"
                PreviewKeyDown="OnSearchKey" />
            <FontIcon
                Glyph="&#xE721;"
                FontSize="16"
                FontFamily="Segoe Fluent Icons"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <Grid x:Name="Body" Grid.Row="1">
            <ScrollViewer
                x:Name="HomeScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="{x:Bind Shown(Popup.ShowingHome), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Pinned"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level1"
                        AutomationProperties.Name="Pinned" />
                    <TextBlock
                        Text="Nothing pinned"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind Shown(Popup.EmptyPins), Mode=OneWay}" />
                    <ScrollViewer
                        x:Name="PinScroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Pins" ItemsSource="{x:Bind Popup.Pinned, Mode=OneWay}" Loaded="OnPinsLoaded">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="taskbar:StartEntry">
                                    <local:StartChunk Entry="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        Text="Recommended"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level1"
                        AutomationProperties.Name="Recommended"
                        Visibility="{x:Bind Shown(Popup.ShowingRecommended), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Popup.Recommended, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="taskbar:StartEntry">
                                <local:StartChunk Entry="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,0"
                        AutomationProperties.Name="All apps"
                        Click="OnAllApps"
                        Content="All apps" />
                </StackPanel>
            </ScrollViewer>
            <Grid Visibility="{x:Bind Shown(Popup.ShowingAll), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="32"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Back"
                        Click="OnBack">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" FontFamily="Segoe Fluent Icons" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        Text="All apps"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level1"
                        AutomationProperties.Name="All apps" />
                </Grid>
                <ListView
                    x:Name="AllList"
                    Grid.Row="1"
                    Padding="0"
                    SelectionMode="None"
                    IsTabStop="False"
                    IsItemClickEnabled="False"
                    IsSwipeEnabled="False"
                    ShowsScrollingPlaceholders="False"
                    ItemContainerStyle="{StaticResource StartRow}"
                    ItemsSource="{x:Bind Popup.All, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="taskbar:StartEntry">
                            <local:StartChunk Entry="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Visibility="{x:Bind Shown(Popup.Searching), Mode=OneWay}">
                <TextBlock
                    Text="No results"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind Shown(Popup.EmptySearch), Mode=OneWay}" />
                <ListView
                    x:Name="ResultsList"
                    Padding="0"
                    SelectionMode="None"
                    IsTabStop="False"
                    IsItemClickEnabled="False"
                    IsSwipeEnabled="False"
                    ShowsScrollingPlaceholders="False"
                    ItemContainerStyle="{StaticResource StartRow}"
                    ItemsSource="{x:Bind Popup.Results, Mode=OneWay}"
                    Visibility="{x:Bind Shown(Popup.ShowingResults), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="taskbar:StartEntry">
                            <local:StartChunk Entry="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <TextBlock
            x:Name="WebNote"
            Grid.Row="2"
            Text="Web results aren't included"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind Shown(Popup.WebNote), Mode=OneWay}" />
    </Grid>
</UserControl>
