<Button
    x:Class="Winshell.DefaultShell.CalendarDayButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36"
    MinWidth="0"
    MinHeight="36"
    Padding="0"
    BorderThickness="0"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    CornerRadius="{ThemeResource ControlCornerRadius}"
    Click="OnClick">
    <Grid>
        <Border x:Name="TodayFill" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="TodayText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="InMonthText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="OutText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" Visibility="Collapsed" />
        <Border x:Name="SelectedStroke" CornerRadius="{ThemeResource ControlCornerRadius}" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="2" Visibility="Collapsed" />
    </Grid>
</Button>
