<UserControl
    x:Class="Winshell.DefaultShell.CalendarFlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    xmlns:taskbar="using:Winshell.DefaultShell.Taskbar"
    xmlns:notifications="using:Winshell.Notifications"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    IsTabStop="True"
    AutomationProperties.Name="Notification center and calendar">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FlyoutFillBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FlyoutFillBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="FlyoutFillBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="16" RowSpacing="12" Background="{ThemeResource FlyoutFillBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Notifications" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Content="Clear all"
                    AutomationProperties.AutomationId="ClearAllButton"
                    Padding="8,4"
                    BorderThickness="0"
                    Background="Transparent"
                    IsEnabled="{x:Bind Center.CanClear, Mode=OneWay}"
                    Click="{x:Bind Center.ClearAll}" />
            </Grid>
            <TextBlock
                Grid.Row="1"
                Text="{x:Bind Center.StatusLine, Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="2"
                HorizontalAlignment="Left"
                Content="{x:Bind Center.AllowText}"
                AutomationProperties.AutomationId="AllowButton"
                Visibility="{x:Bind Shown(Center.ShowAllow), Mode=OneWay}"
                Click="{x:Bind Center.RequestAccess}" />
            <TextBlock
                Grid.Row="3"
                Text="{x:Bind Center.WaitingText}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Shown(Center.ShowWaiting), Mode=OneWay}" />
            <TextBlock
                Grid.Row="4"
                Text="{x:Bind Center.Error, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Shown(Center.ShowError), Mode=OneWay}" />
            <TextBlock
                Grid.Row="5"
                Text="{x:Bind Center.CaughtUpText}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Shown(Center.ShowCaughtUp), Mode=OneWay}" />
            <ScrollViewer
                x:Name="NotificationScroll"
                Grid.Row="6"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                IsTabStop="False">
                <ItemsRepeater
                    Width="{Binding ViewportWidth, ElementName=NotificationScroll, Mode=OneWay}"
                    ItemsSource="{x:Bind Center.VisibleGroups, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="notifications:NotificationGroup">
                            <local:NotificationGroupView Group="{x:Bind Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <ScrollViewer
            x:Name="CalendarScroll"
            Grid.Row="2"
            MaxHeight="360"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            IsTabStop="False">
            <StackPanel Spacing="8" Width="{Binding ViewportWidth, ElementName=CalendarScroll, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind Month.DateLabel, Mode=OneWay}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind Month.MonthLabel, Mode=OneWay}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Content="Today"
                        AutomationProperties.AutomationId="TodayButton"
                        Height="32"
                        Padding="8,4"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="{x:Bind Month.Today}" />
                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Previous month"
                        AutomationProperties.AutomationId="PreviousMonthButton"
                        Click="{x:Bind Month.Previous}">
                        <FontIcon Glyph="&#xE76B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Next month"
                        AutomationProperties.AutomationId="NextMonthButton"
                        Click="{x:Bind Month.Next}">
                        <FontIcon Glyph="&#xE76C;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsRepeater
                        Grid.Row="1"
                        Width="28"
                        ItemsSource="{x:Bind Month.WeekNumbers}"
                        Visibility="{x:Bind Shown(Preferences.CalendarWeekNumbers), Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="taskbar:CalendarWeek">
                                <Grid Width="28" Height="36">
                                    <TextBlock
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Month.WeekdayLabels}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="7" MinItemWidth="0" MinItemHeight="24" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="taskbar:CalendarHeading">
                                <Grid Height="24">
                                    <TextBlock
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ItemsRepeater Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind Month.Days}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="7" MinItemWidth="0" MinItemHeight="36" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="taskbar:CalendarDay">
                                <local:CalendarDayButton Day="{x:Bind Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
                <CheckBox
                    x:Name="WeekBox"
                    Content="Week numbers"
                    AutomationProperties.AutomationId="WeekNumbersBox"
                    IsChecked="{x:Bind Preferences.CalendarWeekNumbers, Mode=OneWay}"
                    Click="OnWeekNumbers" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
