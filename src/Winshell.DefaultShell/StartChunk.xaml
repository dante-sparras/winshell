<UserControl
    x:Class="Winshell.DefaultShell.StartChunk"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    HorizontalAlignment="Stretch"
    ContextRequested="OnContext">
    <Button
        x:Name="Row"
        MinWidth="0"
        MinHeight="0"
        Padding="0"
        BorderThickness="0"
        Background="Transparent"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        IsTabStop="False"
        Click="OnClick">
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
        </Button.Resources>
        <StackPanel>
            <TextBlock
                x:Name="Heading"
                Height="28"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                AutomationProperties.HeadingLevel="Level1"
                Visibility="Collapsed" />
            <Grid x:Name="Body">
                <Border x:Name="FillHover" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Border x:Name="FillPressed" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorTertiaryBrush}" />
                <Image x:Name="IconImage" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                <FontIcon
                    x:Name="Mark"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="Label"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>
        </StackPanel>
    </Button>
</UserControl>
