<UserControl
    x:Class="Winshell.DefaultShell.QuickSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    xmlns:taskbar="using:Winshell.DefaultShell.Taskbar"
    Width="360"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    IsTabStop="True"
    KeyDown="OnKeyDown">
    <!-- A Canvas lays the content out at its full height, so the window can be sized from that. -->
    <Canvas>
    <Grid x:Name="Body" Width="360" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="Main"
            Padding="24,24,24,20"
            Spacing="20"
            Visibility="{x:Bind Shown(Popup.ShowingTiles), Mode=OneWay}">
            <Border
                Height="132"
                Padding="16,12,16,8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind Shown(Popup.Settings.Media.HasSession), Mode=OneWay}">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            TextTrimming="CharacterEllipsis"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Popup.Settings.Media.App, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            TextTrimming="CharacterEllipsis"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Popup.Settings.Media.Title, Mode=OneWay}" />
                        <TextBlock
                            TextTrimming="CharacterEllipsis"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Popup.Settings.Media.Artist, Mode=OneWay}" />
                    </StackPanel>
                    <Image
                        Grid.Column="1"
                        Width="56"
                        Height="56"
                        Margin="0,4,0,0"
                        VerticalAlignment="Top"
                        Stretch="UniformToFill"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="{x:Bind MediaImage(Popup.Settings.Media.Art), Mode=OneWay}"
                        Visibility="{x:Bind Shown(Popup.Settings.Media.HasArt), Mode=OneWay}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button
                            Width="40"
                            Height="40"
                            MinWidth="40"
                            MinHeight="40"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            AutomationProperties.Name="Previous"
                            ToolTipService.ToolTip="Previous"
                            IsEnabled="{x:Bind Popup.Settings.Media.CanPrevious, Mode=OneWay}"
                            Click="{x:Bind Popup.Settings.Media.Previous}">
                            <FontIcon Glyph="&#xE892;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>
                        <Button
                            Width="40"
                            Height="40"
                            MinWidth="40"
                            MinHeight="40"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            AutomationProperties.Name="{x:Bind Popup.Settings.Media.PlayLabel, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Popup.Settings.Media.PlayLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind Popup.Settings.Media.CanToggle, Mode=OneWay}"
                            Click="{x:Bind Popup.Settings.Media.Toggle}">
                            <FontIcon FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="{x:Bind Popup.Settings.Media.PlayGlyph, Mode=OneWay}" />
                        </Button>
                        <Button
                            Width="40"
                            Height="40"
                            MinWidth="40"
                            MinHeight="40"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            AutomationProperties.Name="Next"
                            ToolTipService.ToolTip="Next"
                            IsEnabled="{x:Bind Popup.Settings.Media.CanNext, Mode=OneWay}"
                            Click="{x:Bind Popup.Settings.Media.Next}">
                            <FontIcon Glyph="&#xE893;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Not an ItemsRepeater: it realizes only what fits the window's first height, and is not told when that grows. -->
            <ItemsControl x:Name="Tiles" ItemsSource="{x:Bind Popup.Settings.Pins.Shown, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" Loaded="OnTileGridLoaded" ItemWidth="108" ItemHeight="82" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="taskbar:QuickSettingsTile">
                        <local:QuickSettingsTileView Tile="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="4">
                <local:SliderRow
                    x:Name="VolumeRow"
                    Glyph="{x:Bind Popup.Settings.Status.VolumeGlyph, Mode=OneWay}"
                    GlyphLabel="{x:Bind Popup.Settings.Sound.MuteLabel, Mode=OneWay}"
                    Label="Volume"
                    PageLabel="Select a sound output"
                    Value="{x:Bind Popup.Settings.Sound.Volume, Mode=OneWay}"
                    IsEnabled="{x:Bind Popup.Settings.Sound.HasOutput, Mode=OneWay}" />
                <local:SliderRow
                    x:Name="BrightnessRow"
                    Glyph="&#xE706;"
                    Label="Brightness"
                    Value="{x:Bind Popup.Settings.Brightness.Level, Mode=OneWay}"
                    Visibility="{x:Bind Shown(Popup.Settings.Brightness.HasPanel), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
        <!-- The pages sit where the tiles are, at their height. The view sets it, as ActualHeight cannot be bound. -->
        <Grid x:Name="Pages">
            <Grid
                Padding="12,12,12,0"
                RowSpacing="4"
                Background="Transparent"
                Visibility="{x:Bind Shown(Popup.ShowingPowerMode), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back"
                        Click="{x:Bind Popup.Back}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="Power mode" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Popup.Settings.PowerMode.Choices, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="taskbar:QuickSettingsChoice">
                            <local:ChoiceButton Choice="{x:Bind}" Group="powerMode" Margin="12,0,12,0" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
            <Grid
                Padding="12,12,12,0"
                RowSpacing="4"
                Background="Transparent"
                Visibility="{x:Bind Shown(Popup.ShowingOutput), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back"
                        Click="{x:Bind Popup.Back}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="Sound output" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <Button
                    Grid.Row="1"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="4,0,0,0"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    BorderThickness="0"
                    Background="Transparent"
                    Content="App volume"
                    Click="{x:Bind Popup.ShowVolume}" />
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind Popup.Settings.Sound.Outputs, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="taskbar:QuickSettingsChoice">
                                <local:ChoiceButton Choice="{x:Bind}" Group="output" Margin="12,0,12,0" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <Button
                    Grid.Row="3"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="4,0,0,0"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    BorderThickness="0"
                    Background="Transparent"
                    Content="More volume settings"
                    Click="{x:Bind Popup.OpenVolumeSettings}" />
            </Grid>
            <Grid
                Padding="12,12,12,0"
                RowSpacing="4"
                Background="Transparent"
                Visibility="{x:Bind Shown(Popup.ShowingVolume), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back"
                        Click="{x:Bind Popup.Back}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="App volume" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Disabled">
                    <ItemsRepeater Margin="12,0,12,0" ItemsSource="{x:Bind Popup.Settings.Sound.Sessions, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="taskbar:QuickSettingsSession">
                                <local:SliderRow
                                    HorizontalAlignment="Stretch"
                                    Session="{x:Bind}"
                                    Label="{x:Bind Label, Mode=OneWay}"
                                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                                    GlyphLabel="{x:Bind MuteLabel, Mode=OneWay}"
                                    Value="{x:Bind Volume, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <Button
                    Grid.Row="2"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="4,0,0,0"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    BorderThickness="0"
                    Background="Transparent"
                    Content="More volume settings"
                    Click="{x:Bind Popup.OpenVolumeSettings}" />
            </Grid>
            <Grid
                Padding="12,12,12,0"
                RowSpacing="4"
                Background="Transparent"
                Visibility="{x:Bind Shown(Popup.ShowingAdd), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back"
                        Click="{x:Bind Popup.Back}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <TextBlock Text="Add" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <!-- A short list, so every row is realized. An ItemsRepeater would stop at the window's first height. -->
                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Popup.Settings.Pins.Unpinned, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="taskbar:QuickSettingsTile">
                            <Button
                                MinWidth="0"
                                MinHeight="0"
                                Margin="4,0,4,0"
                                Padding="8,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                BorderThickness="0"
                                Background="Transparent"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Tag="{x:Bind Key}"
                                Click="OnAddTile">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
        <Border
            Grid.Row="1"
            Height="48"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Button
                    MinWidth="0"
                    MinHeight="0"
                    Margin="12,0,0,0"
                    Padding="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent"
                    AutomationProperties.Name="{x:Bind Popup.Settings.Battery.Text, Mode=OneWay}"
                    Visibility="{x:Bind BatteryShown(Popup.Settings.Status.HasBattery, Popup.Browsing), Mode=OneWay}"
                    Click="{x:Bind Popup.OpenBattery}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="16"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Glyph="{x:Bind Popup.Settings.Status.BatteryGlyph, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Popup.Settings.Battery.Percent, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Visibility="{x:Bind Shown(Popup.Browsing), Mode=OneWay}">
                    <Button
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="Edit quick settings"
                        ToolTipService.ToolTip="Edit quick settings"
                        Click="{x:Bind Popup.Edit}">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <Button
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="All settings"
                        ToolTipService.ToolTip="All settings"
                        Click="{x:Bind Popup.OpenAllSettings}">
                        <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Spacing="8"
                    Visibility="{x:Bind Shown(Popup.Editing), Mode=OneWay}">
                    <Button
                        MinWidth="0"
                        MinHeight="0"
                        Padding="12,5"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Add"
                        IsEnabled="{x:Bind CanAdd(Popup.Settings.Pins.HasUnpinned, Popup.ShowingAdd), Mode=OneWay}"
                        Click="{x:Bind Popup.ShowAdd}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                            <TextBlock VerticalAlignment="Center" Text="Add" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinWidth="0"
                        MinHeight="0"
                        Padding="12,5"
                        VerticalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}"
                        AutomationProperties.Name="Done"
                        Content="Done"
                        Click="{x:Bind Popup.Done}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Canvas>
</UserControl>
