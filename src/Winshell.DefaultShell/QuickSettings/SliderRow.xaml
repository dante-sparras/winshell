<UserControl
    x:Class="Winshell.DefaultShell.SliderRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40"
    HorizontalAlignment="Stretch">
    <Grid Height="40" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
            Width="40"
            Height="40"
            MinWidth="40"
            MinHeight="40"
            Padding="0"
            BorderThickness="0"
            Background="Transparent"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind GlyphLabel, Mode=OneWay}"
            Visibility="{x:Bind ButtonShown(GlyphLabel), Mode=OneWay}"
            Click="OnGlyphClick">
            <FontIcon FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="{x:Bind Glyph, Mode=OneWay}" />
        </Button>
        <TextBlock
            Width="40"
            VerticalAlignment="Center"
            TextAlignment="Center"
            FontSize="16"
            FontFamily="Segoe Fluent Icons"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw"
            Text="{x:Bind Glyph, Mode=OneWay}"
            Visibility="{x:Bind TextShown(GlyphLabel), Mode=OneWay}" />
        <Slider
            x:Name="Range"
            Grid.Column="1"
            Minimum="0"
            Maximum="1"
            StepFrequency="0.01"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
            ValueChanged="OnRangeChanged" />
        <Button
            Grid.Column="2"
            Width="40"
            Height="40"
            MinWidth="40"
            MinHeight="40"
            Padding="0"
            BorderThickness="0"
            Background="Transparent"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind PageLabel, Mode=OneWay}"
            Visibility="{x:Bind ButtonShown(PageLabel), Mode=OneWay}"
            Click="OnPageClick">
            <FontIcon Glyph="&#xE76C;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Button>
    </Grid>
</UserControl>
