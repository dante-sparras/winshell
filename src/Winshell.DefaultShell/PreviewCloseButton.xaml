<Button
    x:Class="Winshell.DefaultShell.PreviewCloseButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="24"
    Height="24"
    MinWidth="0"
    MinHeight="0"
    Padding="0"
    BorderThickness="0"
    Background="Transparent"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="Close">
    <Button.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PreviewCloseHoverBrush" Color="#c42b1c" />
                    <SolidColorBrush x:Key="PreviewClosePressedBrush" Color="#e6c42b1c" />
                    <SolidColorBrush x:Key="PreviewCloseHoverGlyphBrush" Color="#ffffff" />
                    <SolidColorBrush x:Key="PreviewClosePressedGlyphBrush" Color="#b3ffffff" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PreviewCloseHoverBrush" Color="#c42b1c" />
                    <SolidColorBrush x:Key="PreviewClosePressedBrush" Color="#e6c42b1c" />
                    <SolidColorBrush x:Key="PreviewCloseHoverGlyphBrush" Color="#ffffff" />
                    <SolidColorBrush x:Key="PreviewClosePressedGlyphBrush" Color="#b3ffffff" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PreviewCloseHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="PreviewClosePressedBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="PreviewCloseHoverGlyphBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="PreviewClosePressedGlyphBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Button.Resources>
    <Button.Template>
        <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </ControlTemplate>
    </Button.Template>
    <Grid>
        <Border x:Name="HoverFill" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource PreviewCloseHoverBrush}" Visibility="Collapsed" />
        <Border x:Name="PressedFill" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource PreviewClosePressedBrush}" Visibility="Collapsed" />
        <TextBlock
            x:Name="RestGlyph"
            Text="&#xE8BB;"
            FontFamily="Segoe Fluent Icons"
            FontSize="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        <TextBlock
            x:Name="HoverGlyph"
            Text="&#xE8BB;"
            FontFamily="Segoe Fluent Icons"
            FontSize="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource PreviewCloseHoverGlyphBrush}"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="PressedGlyph"
            Text="&#xE8BB;"
            FontFamily="Segoe Fluent Icons"
            FontSize="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource PreviewClosePressedGlyphBrush}"
            Visibility="Collapsed" />
    </Grid>
</Button>
