<UserControl
    x:Class="Winshell.DefaultShell.SettingsPersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <local:SettingsCard x:Name="SchemeCard">
            <local:SettingsCard.TrailContent>
                <ComboBox x:Name="Scheme" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="OnSchemeChanged" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <local:SettingsCard x:Name="AccentCard">
            <local:SettingsCard.TrailContent>
                <ComboBox x:Name="Accent" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="OnAccentChanged" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <Border
            x:Name="Swatches"
            Margin="0,4,0,0"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            AutomationProperties.Name="Windows colors"
            Visibility="Collapsed"
            SizeChanged="OnSwatchSize">
            <Grid
                x:Name="SwatchGrid"
                Margin="52,16,16,16"
                ColumnSpacing="4"
                RowSpacing="4"
                PreviewKeyDown="OnSwatchKey" />
        </Border>
        <local:SettingsCard x:Name="MaterialCard">
            <local:SettingsCard.TrailContent>
                <ComboBox x:Name="Material" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="OnMaterialChanged" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <TextBlock Text="Related settings" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,18,0,6" />
        <local:SettingsLink x:Name="Colors" />
    </StackPanel>
</UserControl>
