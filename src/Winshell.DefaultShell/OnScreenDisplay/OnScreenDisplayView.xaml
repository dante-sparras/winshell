<UserControl
    x:Class="Winshell.DefaultShell.OnScreenDisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="OsdFillBrush" Color="Transparent" />
                    <Thickness x:Key="OsdBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OsdFillBrush" Color="Transparent" />
                    <Thickness x:Key="OsdBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="OsdFillBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                    <Thickness x:Key="OsdBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="Card"
        Opacity="0"
        Background="{ThemeResource OsdFillBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="{ThemeResource OsdBorderThickness}"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        AutomationProperties.Name="{x:Bind Model.Announcement, Mode=OneWay}"
        AutomationProperties.LiveSetting="Assertive"
        PointerEntered="OnEntered"
        PointerExited="OnExited">
        <StackPanel Padding="16" Spacing="8">
            <Grid Height="48" ColumnSpacing="12" Visibility="{x:Bind Shown(Model.ShowMedia), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <Image x:Name="Art" Stretch="UniformToFill" Visibility="{x:Bind Shown(Model.HasArt), Mode=OneWay}" />
                        <FontIcon
                            Glyph="{x:Bind local:OnScreenDisplayModel.ArtGlyph}"
                            FontSize="20"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind Hidden(Model.HasArt), Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        Text="{x:Bind Model.MediaHeading, Mode=OneWay}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind Model.MediaArtist, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind Shown(Model.ShowArtist), Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Previous"
                    IsEnabled="{x:Bind Model.CanGoPrevious, Mode=OneWay}"
                    Click="{x:Bind Model.Previous}"
                    PointerEntered="OnEntered">
                    <FontIcon Glyph="{x:Bind local:OnScreenDisplayModel.PreviousGlyph}" FontSize="16" FontFamily="Segoe Fluent Icons" />
                </Button>
                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind Model.PlayName, Mode=OneWay}"
                    IsEnabled="{x:Bind Model.CanTogglePlayback, Mode=OneWay}"
                    Click="{x:Bind Model.TogglePlayback}"
                    PointerEntered="OnEntered">
                    <FontIcon Glyph="{x:Bind Model.PlayGlyph, Mode=OneWay}" FontSize="16" FontFamily="Segoe Fluent Icons" />
                </Button>
                <Button
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Next"
                    IsEnabled="{x:Bind Model.CanGoNext, Mode=OneWay}"
                    Click="{x:Bind Model.Next}"
                    PointerEntered="OnEntered">
                    <FontIcon Glyph="{x:Bind local:OnScreenDisplayModel.NextGlyph}" FontSize="16" FontFamily="Segoe Fluent Icons" />
                </Button>
            </Grid>
            <Grid Height="32" ColumnSpacing="16" Visibility="{x:Bind Shown(Model.ShowLevel), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Glyph="{x:Bind Model.LevelGlyph, Mode=OneWay}"
                    FontSize="16"
                    FontFamily="Segoe Fluent Icons"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />
                <Slider
                    Grid.Column="1"
                    Minimum="{x:Bind Model.LevelMinimum, Mode=OneWay}"
                    Maximum="{x:Bind Model.LevelMaximum, Mode=OneWay}"
                    Value="{x:Bind Model.Level, Mode=OneWay}"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind Model.LevelName, Mode=OneWay}" />
            </Grid>
            <Grid Height="32" ColumnSpacing="16" Visibility="{x:Bind Shown(Model.ShowMicrophone), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Glyph="{x:Bind Model.MicrophoneGlyph, Mode=OneWay}"
                    FontSize="16"
                    FontFamily="Segoe Fluent Icons"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Model.MicrophoneText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
