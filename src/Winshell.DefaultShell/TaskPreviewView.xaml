<UserControl
    x:Class="Winshell.DefaultShell.TaskPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    IsTabStop="False"
    AutomationProperties.Name="Preview">
    <UserControl.Resources>
        <Style x:Key="PreviewCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewHover" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="PreviewCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PreviewBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- Transparent so the padding around a card still counts as inside the preview. -->
    <Grid x:Name="Root" Padding="8" Background="Transparent">
        <TextBlock
            x:Name="NameText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{ThemeResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Visibility="Collapsed" />
        <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" />
        <ScrollViewer
            x:Name="ListHost"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ZoomMode="Disabled"
            IsTabStop="False"
            Visibility="Collapsed">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>
    </Grid>
</UserControl>
