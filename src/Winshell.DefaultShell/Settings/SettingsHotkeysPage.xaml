<UserControl
    x:Class="Winshell.DefaultShell.SettingsHotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <TextBlock
            Text="Type a key with Win, Ctrl or Alt before it, and Shift if you like, such as Ctrl+Alt+S. Win alone is the Windows key. Leave it empty to turn the hotkey off."
            TextWrapping="Wrap"
            Margin="0,0,0,8"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:SettingsCard x:Name="StartCard">
            <local:SettingsCard.TrailContent>
                <TextBox
                    x:Name="StartField"
                    Width="200"
                    PlaceholderText="None"
                    PreviewKeyDown="OnFieldKey"
                    LostFocus="OnFieldLostFocus" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <local:SettingsCard x:Name="SettingsCard">
            <local:SettingsCard.TrailContent>
                <TextBox
                    x:Name="SettingsField"
                    Width="200"
                    PlaceholderText="None"
                    PreviewKeyDown="OnFieldKey"
                    LostFocus="OnFieldLostFocus" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <local:SettingsCard x:Name="ChordsCard">
            <local:SettingsCard.TrailContent>
                <ToggleSwitch x:Name="Chords" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnChordsToggled" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
    </StackPanel>
</UserControl>
