<UserControl
    x:Class="Winshell.DefaultShell.SettingsOrderRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    IsTabStop="False">
    <Border
        Height="48"
        Padding="16,0,8,0"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid ColumnSpacing="12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="GlyphIcon"
                FontFamily="Segoe Fluent Icons"
                FontSize="20"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                AutomationProperties.AccessibilityView="Raw" />
            <Image
                x:Name="Icon"
                Grid.Column="1"
                Width="20"
                Height="20"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Name="Label"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Style="{ThemeResource BodyTextBlockStyle}"
                AutomationProperties.AccessibilityView="Raw" />
            <Button
                x:Name="Up"
                Grid.Column="3"
                Width="36"
                Height="36"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                Click="OnUp">
                <FontIcon Glyph="&#xE70E;" FontSize="16" FontFamily="Segoe Fluent Icons" AutomationProperties.AccessibilityView="Raw" />
            </Button>
            <Button
                x:Name="Down"
                Grid.Column="4"
                Width="36"
                Height="36"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                Click="OnDown">
                <FontIcon Glyph="&#xE70D;" FontSize="16" FontFamily="Segoe Fluent Icons" AutomationProperties.AccessibilityView="Raw" />
            </Button>
            <Button
                x:Name="Remove"
                Grid.Column="5"
                Width="36"
                Height="36"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                Click="OnRemove">
                <FontIcon Glyph="&#xE77A;" FontSize="16" FontFamily="Segoe Fluent Icons" AutomationProperties.AccessibilityView="Raw" />
            </Button>
        </Grid>
    </Border>
</UserControl>
