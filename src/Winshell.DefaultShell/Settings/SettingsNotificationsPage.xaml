<UserControl
    x:Class="Winshell.DefaultShell.SettingsNotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <local:SettingsLink x:Name="Disturb" />
        <local:SettingsCard x:Name="AppsCard" />
        <TextBlock
            x:Name="Empty"
            Text="Apps show up here once they have sent a notification."
            TextWrapping="Wrap"
            Margin="0,8,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel x:Name="Apps" Spacing="4" />
    </StackPanel>
</UserControl>
