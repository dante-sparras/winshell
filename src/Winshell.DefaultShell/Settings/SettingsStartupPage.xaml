<UserControl
    x:Class="Winshell.DefaultShell.SettingsStartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <local:SettingsCard x:Name="SignInCard">
            <local:SettingsCard.TrailContent>
                <ToggleSwitch x:Name="SignIn" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnSignInToggled" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <TextBlock Text="Related settings" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,18,0,6" />
        <local:SettingsLink x:Name="StartupApps" />
    </StackPanel>
</UserControl>
