<UserControl
    x:Class="Winshell.DefaultShell.SettingsStartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <local:SettingsCard x:Name="RecommendedCard">
            <local:SettingsCard.TrailContent>
                <ToggleSwitch x:Name="Recommended" OnContent="On" OffContent="Off" Toggled="OnRecommendedToggled" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <local:SettingsCommand x:Name="Pins" Click="OnPins" />
    </StackPanel>
</UserControl>
