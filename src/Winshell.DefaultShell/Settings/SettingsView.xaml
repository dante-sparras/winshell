<UserControl
    x:Class="Winshell.DefaultShell.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="Transparent">
    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        IsPaneOpen="True"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        IsBackButtonVisible="Collapsed"
        OpenPaneLength="280"
        IsTitleBarAutoPaddingEnabled="False"
        AlwaysShowHeader="True"
        SelectionFollowsFocus="Enabled"
        Background="Transparent"
        AutomationProperties.Name="Settings"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <!-- The page title starts where the cards do: the body's left margin, not NavigationView's 56. -->
            <Thickness x:Key="NavigationViewHeaderMargin">40,44,0,0</Thickness>
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <AutoSuggestBox
                x:Name="Search"
                Margin="16,8,16,8"
                PlaceholderText="Find a setting"
                AutomationProperties.Name="Find a setting"
                TextChanged="OnSearchTextChanged"
                QuerySubmitted="OnSearchSubmitted"
                PreviewKeyDown="OnSearchKeyDown">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </NavigationView.PaneHeader>
        <NavigationView.Header>
            <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" Spacing="8" />
        </NavigationView.Header>
        <ScrollViewer
            x:Name="Scroll"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            SizeChanged="OnScrollSizeChanged">
            <StackPanel x:Name="Body" HorizontalAlignment="Left" Spacing="4" Margin="40,12,40,40">
                <InfoBar
                    x:Name="PreferencesError"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Error"
                    Message="Your preferences.toml has an error. Changes won't be saved until it's fixed." />
                <StackPanel x:Name="Results" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        x:Name="Empty"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed" />
                </StackPanel>
                <Grid x:Name="Pages" />
            </StackPanel>
        </ScrollViewer>
    </NavigationView>
</UserControl>
