<UserControl
    x:Class="Winshell.DefaultShell.SettingsQuickSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <local:SettingsCard x:Name="TilesCard" />
        <local:SettingsOrderList x:Name="Tiles" />
        <TextBlock
            x:Name="AddHeader"
            Text="Add tiles"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Margin="0,18,0,6"
            AutomationProperties.HeadingLevel="Level2" />
        <StackPanel x:Name="Add" Spacing="4" />
    </StackPanel>
</UserControl>
