<UserControl
    x:Class="Winshell.DefaultShell.SettingsTaskbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <local:SettingsCard x:Name="AlignmentCard">
            <local:SettingsCard.TrailContent>
                <ComboBox x:Name="Alignment" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="OnAlignmentChanged" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <local:SettingsCard x:Name="AutoHideCard">
            <local:SettingsCard.TrailContent>
                <ToggleSwitch x:Name="AutoHide" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnAutoHideToggled" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <TextBlock Text="Multiple displays" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,18,0,6" />
        <local:SettingsCard x:Name="AllScreensCard">
            <local:SettingsCard.TrailContent>
                <ToggleSwitch x:Name="AllScreens" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnAllScreensToggled" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <local:SettingsCard x:Name="AppsCard">
            <local:SettingsCard.TrailContent>
                <ComboBox x:Name="Apps" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="OnAppsChanged" />
            </local:SettingsCard.TrailContent>
        </local:SettingsCard>
        <TextBlock Text="Related settings" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,18,0,6" />
        <local:SettingsLink x:Name="Tray" />
    </StackPanel>
</UserControl>
