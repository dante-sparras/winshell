<UserControl
    x:Class="Winshell.DefaultShell.QuickSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winshell.DefaultShell"
    xmlns:taskbar="using:Winshell.DefaultShell.Taskbar"
    Width="360"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    IsTabStop="True"
    KeyDown="OnKeyDown">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="Main"
            Padding="24,24,24,20"
            Spacing="20"
            Opacity="{x:Bind Fade(Popup.ShowingTiles), Mode=OneWay}"
            IsHitTestVisible="{x:Bind Popup.ShowingTiles, Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind Popup.Settings.Shown, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        Orientation="Horizontal"
                        MaximumRowsOrColumns="3"
                        MinItemWidth="96"
                        MinColumnSpacing="12"
                        MinRowSpacing="12"
                        ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="taskbar:QuickSettingsTile">
                        <local:QuickSettingsTileView Tile="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel Spacing="4">
                <local:SliderRow
                    x:Name="VolumeRow"
                    Glyph="{x:Bind Popup.Settings.Status.VolumeGlyph, Mode=OneWay}"
                    GlyphLabel="{x:Bind Popup.Settings.MuteLabel, Mode=OneWay}"
                    Label="Volume"
                    PageLabel="Select a sound output"
                    Value="{x:Bind Popup.Settings.Volume, Mode=OneWay}"
                    IsEnabled="{x:Bind Popup.Settings.HasOutput, Mode=OneWay}" />
                <local:SliderRow
                    x:Name="BrightnessRow"
                    Glyph="&#xE706;"
                    Label="Brightness"
                    Value="{x:Bind Popup.Settings.Brightness, Mode=OneWay}"
                    Visibility="{x:Bind Shown(Popup.Settings.HasBrightness), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
        <Grid
            Height="{x:Bind Main.ActualHeight, Mode=OneWay}"
            Padding="12,12,12,0"
            RowSpacing="4"
            Background="Transparent"
            Visibility="{x:Bind Shown(Popup.ShowingPowerMode), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Width="40"
                    Height="40"
                    MinWidth="40"
                    MinHeight="40"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                    Click="{x:Bind Popup.Back}">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <TextBlock Text="Power mode" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Popup.Settings.Modes, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="taskbar:QuickSettingsChoice">
                        <local:ChoiceButton Choice="{x:Bind}" Group="powerMode" Margin="12,0,12,0" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>
        <Grid
            Height="{x:Bind Main.ActualHeight, Mode=OneWay}"
            Padding="12,12,12,0"
            RowSpacing="4"
            Background="Transparent"
            Visibility="{x:Bind Shown(Popup.ShowingOutput), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Width="40"
                    Height="40"
                    MinWidth="40"
                    MinHeight="40"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                    Click="{x:Bind Popup.Back}">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <TextBlock Text="Sound output" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <Button
                Grid.Row="1"
                MinWidth="0"
                MinHeight="0"
                Margin="4,0,0,0"
                Padding="8,4"
                HorizontalAlignment="Left"
                BorderThickness="0"
                Background="Transparent"
                Content="App volume"
                Click="{x:Bind Popup.ShowVolume}" />
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind Popup.Settings.Outputs, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="taskbar:QuickSettingsChoice">
                            <local:ChoiceButton Choice="{x:Bind}" Group="output" Margin="12,0,12,0" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <Button
                Grid.Row="3"
                MinWidth="0"
                MinHeight="0"
                Margin="4,0,0,0"
                Padding="8,4"
                HorizontalAlignment="Left"
                BorderThickness="0"
                Background="Transparent"
                Content="More volume settings"
                Click="{x:Bind Popup.OpenVolumeSettings}" />
        </Grid>
        <Grid
            Height="{x:Bind Main.ActualHeight, Mode=OneWay}"
            Padding="12,12,12,0"
            RowSpacing="4"
            Background="Transparent"
            Visibility="{x:Bind Shown(Popup.ShowingVolume), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Width="40"
                    Height="40"
                    MinWidth="40"
                    MinHeight="40"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                    Click="{x:Bind Popup.Back}">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <TextBlock Text="App volume" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <ItemsRepeater Margin="12,0,12,0" ItemsSource="{x:Bind Popup.Settings.Sessions, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="taskbar:QuickSettingsSession">
                            <local:SliderRow
                                HorizontalAlignment="Stretch"
                                Session="{x:Bind}"
                                Label="{x:Bind Label, Mode=OneWay}"
                                Glyph="{x:Bind Glyph, Mode=OneWay}"
                                GlyphLabel="{x:Bind MuteLabel, Mode=OneWay}"
                                Value="{x:Bind Volume, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <Button
                Grid.Row="2"
                MinWidth="0"
                MinHeight="0"
                Margin="4,0,0,0"
                Padding="8,4"
                HorizontalAlignment="Left"
                BorderThickness="0"
                Background="Transparent"
                Content="More volume settings"
                Click="{x:Bind Popup.OpenVolumeSettings}" />
        </Grid>
        <Border
            Grid.Row="1"
            Height="48"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Button
                    MinWidth="0"
                    MinHeight="0"
                    Margin="12,0,0,0"
                    Padding="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent"
                    AutomationProperties.Name="{x:Bind Popup.Settings.BatteryText, Mode=OneWay}"
                    Visibility="{x:Bind Shown(Popup.Settings.Status.HasBattery), Mode=OneWay}"
                    Click="{x:Bind Popup.OpenBattery}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="16"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Glyph="{x:Bind Popup.Settings.Status.BatteryGlyph, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Popup.Settings.BatteryPercent, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    Width="40"
                    Height="40"
                    MinWidth="40"
                    MinHeight="40"
                    Margin="0,0,12,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent"
                    AutomationProperties.Name="All settings"
                    ToolTipService.ToolTip="All settings"
                    Click="{x:Bind Popup.OpenAllSettings}">
                    <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
