<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>winshell</AssemblyName>
    <RootNamespace>Winshell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- scripts/package.ps1 names the repository a release build comes from. A build with it updates itself from that
       repository's GitHub Releases; a build from source has none and never does. -->
  <ItemGroup Condition="'$(WinshellReleaseRepository)' != ''">
    <AssemblyMetadata Include="WinshellReleaseRepository" Value="$(WinshellReleaseRepository)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Winshell.Platform.Windows\Winshell.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="DefaultShell\**\*" LogicalName="DefaultShell/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Winshell.Tests" />
  </ItemGroup>
</Project>
