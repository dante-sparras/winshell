<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Winshell</RootNamespace>
    <AssemblyName>Winshell.Host</AssemblyName>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <SelfContained Condition="'$(_IsPublishing)' != 'true'">false</SelfContained>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winshell.Core\Winshell.Core.csproj" />
    <ProjectReference Include="..\Winshell.Kit\Winshell.Kit.csproj" />
    <PackageReference Include="Winland.Ipc" Version="$(WinlandVersion)" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <!--
      Winoma uses Windows Forms and is loaded by path, so it is not in this reference graph.
      A self-contained publish otherwise omits Microsoft.WindowsDesktop.App, and those types fail to load.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <RuntimeHostConfigurationOption Include="System.Net.SocketsHttpHandler.Http3Support" Value="false" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <Using Include="Winshell.Core" />
    <Using Include="Winshell.Core.Diagnostics" />
    <Using Include="Winshell.Kit" />
    <Using Include="Winland.Ipc" />
  </ItemGroup>

  <!--
    The shell watcher is this program under its own name. Stopping every Winshell.Host process leaves it running,
    and it gives the taskbar back. ADR 0059.
  -->
  <Target Name="CopyWatchExe" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).exe" DestinationFiles="$(OutputPath)Winshell.Watch.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishWatchExe" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)Winshell.Watch.exe" />
  </Target>
</Project>
