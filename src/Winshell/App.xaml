<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Winshell.ShellApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The Kit reads these keys. They live only here. -->
            <SolidColorBrush x:Key="BarBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="BarForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="BarMutedBrush" Color="#FFC8C8C8" />
            <SolidColorBrush x:Key="BarHoverBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="BarPressedBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="BarSelectedBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="BarStrokeBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="BarHitBrush" Color="#01FFFFFF" />
            <SolidColorBrush x:Key="BarAccentBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="BarAccentTextBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="BarOnAccentBrush" Color="#FFFFFFFF" />
            <Style x:Key="BarTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextLineBounds" Value="Tight" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="PanelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BarTextStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="TextLineBounds" Value="Full" />
            </Style>
            <Style x:Key="BarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BarHitBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BarForegroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent">
                                <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.083" />
                                    </Border.BackgroundTransition>
                                </Border>
                                <Border x:Name="Wash" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.083" />
                                    </Border.BackgroundTransition>
                                </Border>
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Wash.Background" Value="{StaticResource BarHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Wash.Background" Value="{StaticResource BarPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PanelRowStyle" TargetType="Button" BasedOn="{StaticResource BarButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
