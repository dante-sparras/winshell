<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Winshell.Templates</PackageId>
    <Title>Winshell templates</Title>
    <Description>The dotnet new template for a Winshell shell.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/enpaze/winshell</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- .template.config is a dotted directory, which the default excludes skip. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- A template package has no lib folder, so the framework match check does not apply. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TemplatePackage.cs" />
  </ItemGroup>

  <!-- Pack the template where it lives. Only MyShell.csproj is written into obj, with the package version stamped in.
       Property functions cannot write a file. WriteLinesToFile splits on ';' and would expand $(...) in the project,
       so the text is escaped first: % then $ then ;. -->
  <Target Name="StampTemplateProject" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_TemplateSource>$(MSBuildThisFileDirectory)winshell\MyShell.csproj</_TemplateSource>
      <_StampedProject>$(IntermediateOutputPath)MyShell.csproj</_StampedProject>
      <_StampedText>$([System.IO.File]::ReadAllText('$(_TemplateSource)').Replace('__WINSHELL_VERSION__', '$(Version)').Replace('%', '%25').Replace('$', '%24').Replace(';', '%3B'))</_StampedText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_StampedProject)" Lines="$(_StampedText)" Overwrite="true" />
    <ItemGroup>
      <_TemplateContent Include="$(MSBuildThisFileDirectory)winshell\**\*"
                        Exclude="$(MSBuildThisFileDirectory)winshell\MyShell.csproj;$(MSBuildThisFileDirectory)winshell\**\bin\**\*;$(MSBuildThisFileDirectory)winshell\**\obj\**\*" />
      <Content Include="@(_TemplateContent)" Pack="true" PackagePath="content\winshell\%(RecursiveDir)%(Filename)%(Extension)" />
      <Content Include="$(_StampedProject)" Pack="true" PackagePath="content\winshell\MyShell.csproj" />
    </ItemGroup>
  </Target>
</Project>
