<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Winshell.Templates</PackageId>
    <Title>Winshell templates</Title>
    <Description>dotnet new templates for a Winshell shell and the default shell.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/enpaze/winshell</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- .template.config is a dotted directory, which the default excludes skip. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- A template package has no lib folder, so the framework match check does not apply. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TemplatePackage.cs" />
  </ItemGroup>

  <!-- The default shell's XAML and C# are copied from Winshell.DefaultShell at pack time, so the template cannot drift. -->
  <Target Name="StageTemplates" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_Stage>$(IntermediateOutputPath)stage\</_Stage>
    </PropertyGroup>
    <RemoveDir Directories="$(_Stage)" />
    <ItemGroup>
      <_DefaultSource Include="$(MSBuildThisFileDirectory)..\src\Winshell.DefaultShell\**\*.cs" />
      <_DefaultSource Include="$(MSBuildThisFileDirectory)..\src\Winshell.DefaultShell\**\*.xaml" />
      <_DefaultSource Remove="$(MSBuildThisFileDirectory)..\src\Winshell.DefaultShell\**\bin\**\*" />
      <_DefaultSource Remove="$(MSBuildThisFileDirectory)..\src\Winshell.DefaultShell\**\obj\**\*" />
      <_SmallSource Include="$(MSBuildThisFileDirectory)winshell\**\*" />
      <_SmallSource Remove="$(MSBuildThisFileDirectory)winshell\**\bin\**\*" />
      <_SmallSource Remove="$(MSBuildThisFileDirectory)winshell\**\obj\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DefaultSource)" DestinationFiles="@(_DefaultSource->'$(_Stage)winshell-default\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)winshell-default\Program.cs" DestinationFiles="$(_Stage)winshell-default\Program.cs" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)winshell-default\.template.config\template.json" DestinationFiles="$(_Stage)winshell-default\.template.config\template.json" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)winshell-default\MyShell.csproj.in" DestinationFiles="$(_Stage)winshell-default\MyShell.csproj" />
    <Copy SourceFiles="@(_SmallSource)" DestinationFiles="@(_SmallSource->'$(_Stage)winshell\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <_Versioned Include="$(_Stage)winshell\MyShell.csproj" />
      <_Versioned Include="$(_Stage)winshell-default\MyShell.csproj" />
    </ItemGroup>
    <StampTemplateVersion Version="$(Version)" Files="@(_Versioned)" />
    <ItemGroup>
      <_Staged Include="$(_Stage)**\*" />
      <Content Include="@(_Staged)" Pack="true" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="StampTemplateVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Version ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (var file in Files)
        {
            var path = file.ItemSpec;
            var text = File.ReadAllText(path).Replace("__WINSHELL_VERSION__", Version);
            File.WriteAllText(path, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>
</Project>
