<?xml version="1.0" encoding="utf-8"?>
<!--
  Winland.Ipc comes from GitHub Packages (ADR 0177). The feed needs a login: dev.ps1 writes it into the user's
  NuGet config from the gh login, and CI from a secret. dev.ps1 -Local adds %USERPROFILE%\.nuget\local-feed there too.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-dante-sparras" value="https://nuget.pkg.github.com/dante-sparras/index.json" />
  </packageSources>
</configuration>
