<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A package another one brings in is pinned here too, so the graph has one version of each. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- scripts/render-logo.cs draws the logo. The shell does not reference these. -->
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.13" />
    <PackageVersion Include="System.Management" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Build-only, in every project. -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>
</Project>
