<Project>
  <PropertyGroup>
    <!-- Windows 11 22H2 is the oldest Windows Winshell runs on. SupportedOSPlatformVersion defaults to this platform
         version. A project that targets another framework, as the template package does, sets its own. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new SDK feature band must not add analyzer warnings on its own. Raise this deliberately. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <LangVersion>latest</LangVersion>
    <!-- .editorconfig's code style rules fail the build, as the analyzers do. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Paths in a release's binaries and symbols are not this runner's. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The product version is the release-please manifest. -p:Version= overrides it.
       A build that cannot read the manifest is 0.0.0-dev. Projects are not packable unless they opt in. -->
  <PropertyGroup>
    <_WinshellReleaseManifest>$(MSBuildThisFileDirectory).release-please-manifest.json</_WinshellReleaseManifest>
    <IsPackable>false</IsPackable>
    <Authors>dante-sparras</Authors>
    <!-- Every binary's product name, which code signing checks along with the product version. -->
    <Product>Winshell</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Version)' == '' and Exists('$(_WinshellReleaseManifest)')">
    <_WinshellReleaseManifestText>$([System.IO.File]::ReadAllText('$(_WinshellReleaseManifest)'))</_WinshellReleaseManifestText>
    <_WinshellReleaseVersion>$([System.Text.RegularExpressions.Regex]::Match($(_WinshellReleaseManifestText), '\d+\.\d+\.\d+').Value)</_WinshellReleaseVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Version Condition="'$(Version)' == '' and '$(_WinshellReleaseVersion)' != ''">$(_WinshellReleaseVersion)</Version>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
</Project>
