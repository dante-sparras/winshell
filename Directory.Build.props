<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    Winshell.Core and Winshell.Kit are packages on GitHub Packages, and Winoma pins them (ADR 0177). pack.ps1 and CI
    pass Version=0.1.<commits on HEAD>, so one commit is one version wherever it is packed. Only those two set IsPackable.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <IsPackable>false</IsPackable>
    <Authors>dante-sparras</Authors>
    <RepositoryUrl>https://github.com/dante-sparras/winshell</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dante-sparras/winshell</PackageProjectUrl>
  </PropertyGroup>

  <!--
    The Winland this shell speaks to. The handshake refuses a Winland built from another Winland.Ipc (ADR 0176), so the
    release records this version and Winoma installs the Winland it names. dev.ps1 -Local overrides it, in local.props, with a
    version packed from the sibling winland checkout.
  -->
  <PropertyGroup>
    <WinlandVersion>0.1.2</WinlandVersion>
  </PropertyGroup>
  <!-- dev.ps1 -Local writes local.props, which is gitignored, and dev.ps1 -Pinned deletes it. -->
  <Import Project="local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
</Project>
